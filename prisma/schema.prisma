// MyDashboard data model. Multi-tenant by owner: a User sees only the Clients
// they own (cloisonné). Local dev = SQLite; prod = Postgres (flip provider).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  // Login identifier. Nullable only so `db push` can add it to a populated
  // table; the seed backfills it from `email` on first boot and the app treats
  // it as required from then on.
  username     String?  @unique
  // Contact address, optional: it is no longer the credential.
  email        String?  @unique
  name         String?
  passwordHash String
  // SUPER_ADMIN sees everything · ADMIN owns their own clients and invites
  // members onto them · MEMBER only sees clients they were invited to.
  role         String   @default("MEMBER") // SUPER_ADMIN | ADMIN | MEMBER
  mustChangePassword Boolean @default(false) // force a password change on first login
  createdAt    DateTime @default(now())
  agencyName   String?
  agencyLogo   String?
  footerNote   String?
  clients      Client[]
  connections  Connection[]
  providerApps  ProviderApp[]
  assignments  ClientAssignment[]
  posts        Post[]   @relation("PostAuthor")
  approvals    Post[]   @relation("PostApprover")
}

model Client {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  sector     String?
  brandColor String   @default("#4f46e5")
  logoUrl    String?
  createdAt  DateTime @default(now())
  reports    Report[]
  sources    ClientSource[]
  // Members invited onto this client by its owner. Purely additive: ownerId is
  // never rewritten, so revoking an invitation can't orphan a client.
  assignments ClientAssignment[]
  posts       Post[]
  shortLinks  ShortLink[]
}

// "User X may work on client Y". A client with no assignments is private to
// its owner — which is what makes an admin's own clients invisible to the
// other admins without needing a visibility flag.
model ClientAssignment {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, userId])
  @@index([userId])
}

model Report {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title        String   @default("Rapport de performance")
  periodLabel  String?
  compareLabel String?
  // THE reporting period. Providers are queried on these dates — the labels
  // above are cosmetic and must never be the source of truth again.
  periodDays   Int       @default(28) // preset length; ignored when start+end set
  periodStart  DateTime? // custom range (inclusive)
  periodEnd    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  widgets      Widget[]
  shareLinks   ShareLink[]
}

// Public read-only access to a report (the DashThis-style client link).
// Token is unguessable (32 hex chars); revoking = deleting the row.
model ShareLink {
  id        String   @id @default(cuid())
  token     String   @unique
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Widget {
  id        String  @id @default(cuid())
  reportId  String
  report    Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type      String // kpi | line | donut | bar | table | content | illustration
  title     String?
  sourceKey String? // matomo | ga4 | facebook | instagram | linkedin | gmb | manual
  span      Int     @default(12) // grid columns 1..12
  position  Int     @default(0)
  config    Json? // widget settings (metric ids, labels, html, etc.)
}

model Connection {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider     String // matomo | ga4 | meta | gmb | linkedin
  authType     String // oauth | token
  status       String    @default("connected") // connected | error
  accountLabel String?
  accessToken  String? // encrypted at rest
  refreshToken String? // encrypted at rest
  expiresAt    DateTime?
  meta         Json? // non-secret provider config (e.g. matomo url)
  // Which OAuth application minted this grant. A refresh MUST use the same
  // client the authorize step used, so this is recorded rather than inferred:
  // the user can register, edit or delete their app afterwards, and guessing
  // would silently refresh against a different application.
  oauthClientId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  clientSources ClientSource[]
  postTargets   PostTarget[]

  @@unique([ownerId, provider])
}

// ---- Social publishing ----
// A post composed once, published to N targets. Candidate targets are DERIVED
// (ClientSource + connections of assignees) — no destinations table. targetKeys
// holds the composer's selection; PostTarget rows are only created at approval,
// so the scheduler can never see a draft.
model Post {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body         String
  media        Json?     // string[] of "/api/uploads/<uuid>.<ext>"
  targetKeys   Json?     // string[] "connectionId:provider:externalId" — composer selection
  scheduledAt  DateTime? // UTC; null = publish as soon as approved
  // DRAFT | PENDING_APPROVAL | SCHEDULED | PUBLISHING | PUBLISHED | FAILED | CANCELLED
  status       String    @default("DRAFT")
  submittedAt  DateTime?
  reviewNote   String?   // approval/refusal comment
  approvedById String?
  approvedBy   User?     @relation("PostApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  targets      PostTarget[]

  @@index([clientId, scheduledAt]) // calendar
  @@index([clientId, status])      // drafts/upcoming lists
  @@index([status])                // approval queue
}

// Per-network fan-out. The (provider, externalId, label, connectionId) snapshot
// is taken at approval — a later disconnect can't corrupt history. This IS the
// scheduler's work queue; Post.status is a derived cache.
model PostTarget {
  id             String      @id @default(cuid())
  postId         String
  post           Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  provider       String      // linkedin | meta_fb | meta_ig | x | gmb
  externalId     String      // pageId / member URN / "self" / GBP resource name
  label          String      // "Profil LinkedIn — Nicolas" (snapshot)
  connectionId   String?
  connection     Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  // scheduled → running → published | failed | cancelled
  status         String      @default("scheduled")
  attempts       Int         @default(0)
  nextAttemptAt  DateTime?
  lockedAt       DateTime?   // set at claim; an orphaned lock means a crash
  externalPostId String?
  publishedUrl   String?
  publishedAt    DateTime?
  lastError      String?     // French, displayed verbatim
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([postId, provider, externalId])
  @@index([status, nextAttemptAt]) // THE claim query
}

// ---- Short links ----
// tools.d-analytica.cloud/l/<code>. targetUrl is stored FINAL (UTM already
// applied) — the redirect handler only does lookup + counting.
model ShortLink {
  id          String   @id @default(cuid())
  code        String   @unique
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targetUrl   String
  originalUrl String
  channel     String?  // linkedin | facebook | instagram | x | gmb | null
  postId      String?  // plain string (no FK) — loose coupling
  label       String?
  createdById String
  disabled    Boolean  @default(false) // kill switch: 410
  createdAt   DateTime @default(now())
  days        ShortLinkClickDay[]

  @@index([clientId])
  @@index([postId])
}

// Daily aggregates only — NO raw rows, NO IP/UA ever persisted.
model ShortLinkClickDay {
  id      String    @id @default(cuid())
  linkId  String
  link    ShortLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  day     String    // "YYYY-MM-DD" UTC
  clicks  Int       @default(0)
  uniques Int       @default(0)
  bots    Int       @default(0)

  @@unique([linkId, day])
  @@index([day])
}

model ClientSource {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider   String // matomo | ga4 | meta | gmb | linkedin
  externalId String // GA4 property id, FB page id, Matomo site id, etc.
  label      String?
  // Which connection this id belongs to. An externalId is only meaningful
  // against the instance it came from (Matomo site "7" means nothing on
  // another server), so the binding records it explicitly.
  connectionId String?
  connection   Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([clientId, provider])
}

// A user's OWN OAuth application for a provider ("bring your own app").
//
// Kept apart from Connection on purpose: the app registration is a durable
// thing you did once at LinkedIn or Meta, while a Connection is a token that
// expires, gets revoked and comes back. Disconnecting must not make you
// re-enter your client id and secret.
//
// Why per user at all: without a legal entity behind the instance, its
// operator cannot sign a provider's developer terms on everyone's behalf —
// and one shared app means one shared rate limit and one shared suspension.
model ProviderApp {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider        String // ga4 | meta | gmb | linkedin
  clientId        String
  clientSecretEnc String // encrypted at rest
  label           String? // e.g. the LinkedIn Page the app lives under
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ownerId, provider])
}
